<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ============================================================
         PERMISSIONS - App ke liye zaroori permissions
         Sirf wahi maangte hain jo actually chahiye
         ============================================================ -->

    <!-- Camera - Face detection ke liye (sirf front camera) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <!-- Notifications - Alarm notification ke liye (Android 13+ mein zaroori) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Exact Alarm - Bilkul sahi waqt par alarm ke liye -->
    <!-- Android 12+ (API 31+) ke liye -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Android 13+ (API 33+) alarm clock apps ke liye -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Vibration - Alarm ki vibration ke liye -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Boot Receiver - Phone restart ke baad alarms restore ke liye -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Full-Screen Alarm - Lock screen par alarm dikhane ke liye -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Foreground Service - Alarm service ke liye -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- ============================================================
         APPLICATION
         ============================================================ -->
    <application
        android:label="FaceUp Alarm"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="false"
        android:allowBackup="false"
        android:fullBackupContent="false">

        <!-- ============================================================
             MAIN ACTIVITY - App ka main screen
             ============================================================ -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:showOnLockScreen="true"
            android:turnScreenOn="true">

            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Alarm intent filter - alarm trigger hone par MainActivity launch hogi -->
            <intent-filter>
                <action android:name="FACEUP_ALARM_ACTION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- ============================================================
             ALARM BROADCAST RECEIVER
             Android OS ye receiver ko alarm time par call karta hai
             ============================================================ -->
        <receiver
            android:name=".AlarmBroadcastReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="FACEUP_ALARM_TRIGGER" />
            </intent-filter>
        </receiver>

        <!-- ============================================================
             ALARM FOREGROUND SERVICE
             Alarm ringtone, vibration aur full-screen notification chalati hai
             ============================================================ -->
        <service
            android:name=".AlarmForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- ============================================================
             BOOT RECEIVER
             Phone restart hone par ye receiver call hota hai
             Ye alarms ko restore karta hai
             STEP 6 mein implement hoga
             ============================================================ -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <!-- MIUI devices ke liye -->
                <action android:name="com.miui.powercenter.poweron" />
            </intent-filter>
        </receiver>

        <!-- Flutter meta-data - hata mat dena! -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Text processing ke liye (Flutter requirement) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Ringtone picker ke liye -->
        <intent>
            <action android:name="android.intent.action.RINGTONE_PICKER"/>
        </intent>
    </queries>

</manifest>
